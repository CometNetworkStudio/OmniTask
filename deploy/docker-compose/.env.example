# 复制为 .env 后按需修改
# 默认只监听回环地址，由宿主机 nginx 反代；本地直连可改为 0.0.0.0。
OMNITASK_BIND=127.0.0.1
OMNITASK_PORT=4096
MYSQL_ROOT_PASSWORD=123456
OMNITASK_ADMIN_USER=admin
OMNITASK_ADMIN_PASSWORD=change-me
# 生产环境建议复制 config.full.yml 为 config.prod.yml 后填密钥，并指向它
OMNITASK_CONFIG_TEMPLATE=./config.full.yml
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn,direct
