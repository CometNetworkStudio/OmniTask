[Unit]
Description=OmniTask server (API + WebSocket + orchestrator + embedded frontend)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/OmniTask/backend
EnvironmentFile=-/home/OmniTask/.env
ExecStart=/home/OmniTask/bin/omnitask-server -conf /home/OmniTask/backend/config/deploy.yml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
