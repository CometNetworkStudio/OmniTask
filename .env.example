# OmniTask 环境变量约定
# 使用：cp .env.example .env 后填写；.env 已被 gitignore，禁止提交真实密钥。
# 各服务读取约定：后端用 env（配合 config/*.yml 的非敏感默认值），Agent 只读 env。

# ---- 后端 ----
# AES-256-GCM 凭据加密主密钥：32 字节，hex(64 字符) 或 base64。
OMNITASK_MASTER_KEY=
# JWT 签名密钥；生产必须覆盖 config 中的默认值。
OMNITASK_JWT_KEY=

# ---- 后端 <-> Agent (gRPC) ----
# Go 后端连接 Python Agent。
OMNITASK_AGENT_ADDR=127.0.0.1:50051
# Python Agent 监听端口。
OMNITASK_AGENT_PORT=50051

# ---- 后端 QuestionBank gRPC（Agent 作为客户端回连）----
OMNITASK_BANK_ADDR=127.0.0.1:9000
OMNITASK_BANK_PORT=9000

# ---- LLM（词达人答题兜底，OpenAI 兼容）----
OMNITASK_LLM_BASE_URL=https://api.deepseek.com
OMNITASK_LLM_API_KEY=
OMNITASK_LLM_MODEL=deepseek-chat
